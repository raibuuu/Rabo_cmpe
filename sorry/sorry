<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>I'm Sorry 🌸</title>
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --pink: #ff6b9d;
      --blush: #ffb3cc;
      --peach: #ffd6a5;
      --cream: #fff9f0;
      --lavender: #c9b8e8;
      --text: #5a3b5d;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      min-height: 100vh;
      background: var(--cream);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Nunito', sans-serif;
      overflow: hidden;
      position: relative;
    }

    /* Floating background blobs */
    .blob {
      position: fixed;
      border-radius: 50%;
      filter: blur(60px);
      opacity: 0.35;
      animation: drift 8s ease-in-out infinite alternate;
      pointer-events: none;
    }
    .blob-1 { width: 400px; height: 400px; background: var(--blush); top: -100px; left: -100px; animation-delay: 0s; }
    .blob-2 { width: 300px; height: 300px; background: var(--peach); bottom: -80px; right: -80px; animation-delay: 2s; }
    .blob-3 { width: 250px; height: 250px; background: var(--lavender); top: 40%; left: 60%; animation-delay: 4s; }

    @keyframes drift {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(20px, 30px) scale(1.05); }
    }

    /* Floating hearts */
    .hearts-bg { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
    .h {
      position: absolute;
      font-size: 1.4rem;
      opacity: 0;
      animation: floatUp 6s ease-in infinite;
    }
    @keyframes floatUp {
      0%   { opacity: 0; transform: translateY(0) rotate(0deg); }
      10%  { opacity: 0.7; }
      90%  { opacity: 0.4; }
      100% { opacity: 0; transform: translateY(-90vh) rotate(40deg); }
    }

    /* Card */
    .card {
      position: relative;
      z-index: 10;
      background: white;
      border-radius: 32px;
      padding: 50px 44px 44px;
      max-width: 440px;
      width: 90%;
      text-align: center;
      box-shadow:
        0 8px 40px rgba(255,107,157,0.18),
        0 2px 12px rgba(201,184,232,0.2);
      animation: popIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      border: 2px solid rgba(255,179,204,0.4);
    }
    @keyframes popIn {
      from { opacity: 0; transform: scale(0.7) translateY(30px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* Bear */
    .bear {
      font-size: 5rem;
      display: block;
      margin-bottom: 8px;
      animation: wiggle 2.5s ease-in-out infinite;
      filter: drop-shadow(0 4px 8px rgba(255,107,157,0.3));
    }
    @keyframes wiggle {
      0%, 100% { transform: rotate(-6deg) scale(1); }
      50%       { transform: rotate(6deg) scale(1.08); }
    }

    h1 {
      font-family: 'Pacifico', cursive;
      font-size: 2.4rem;
      color: var(--pink);
      margin-bottom: 8px;
      text-shadow: 2px 3px 0 rgba(255,107,157,0.15);
      animation: fadeSlide 0.8s 0.3s both;
    }

    .subtitle {
      font-size: 1rem;
      color: var(--lavender);
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 24px;
      animation: fadeSlide 0.8s 0.45s both;
    }

    @keyframes fadeSlide {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .divider {
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--blush), var(--lavender), var(--blush), transparent);
      border-radius: 99px;
      margin: 0 auto 24px;
      width: 80%;
      animation: fadeSlide 0.8s 0.5s both;
    }

    .message {
      font-size: 1.05rem;
      color: var(--text);
      line-height: 1.75;
      margin-bottom: 28px;
      animation: fadeSlide 0.8s 0.6s both;
    }
    .message strong { color: var(--pink); }

    /* Promise list */
    .promises {
      list-style: none;
      text-align: left;
      margin-bottom: 30px;
      animation: fadeSlide 0.8s 0.75s both;
    }
    .promises li {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 14px;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #fff0f5, #f5f0ff);
      border-radius: 14px;
      font-size: 0.97rem;
      color: var(--text);
      border: 1.5px solid rgba(255,179,204,0.35);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .promises li:hover {
      transform: translateX(4px);
      box-shadow: 0 4px 16px rgba(255,107,157,0.12);
    }
    .promises li span.icon { font-size: 1.2rem; flex-shrink: 0; }

    /* Button */
    .btn {
      display: inline-block;
      padding: 14px 36px;
      background: linear-gradient(135deg, var(--pink), var(--lavender));
      color: white;
      font-family: 'Nunito', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 6px 24px rgba(255,107,157,0.35);
      transition: transform 0.2s, box-shadow 0.2s;
      animation: fadeSlide 0.8s 0.9s both;
      letter-spacing: 0.3px;
    }
    .btn:hover {
      transform: translateY(-3px) scale(1.04);
      box-shadow: 0 10px 30px rgba(255,107,157,0.45);
    }
    .btn:active { transform: scale(0.97); }

    /* Confetti burst on click */
    .burst { position: fixed; pointer-events: none; z-index: 999; }
    .dot {
      position: absolute;
      width: 10px; height: 10px;
      border-radius: 50%;
      animation: burst 0.8s ease-out forwards;
    }
    @keyframes burst {
      to { transform: translate(var(--tx), var(--ty)) scale(0); opacity: 0; }
    }

    /* Footer note */
    .footer-note {
      margin-top: 20px;
      font-size: 0.82rem;
      color: #c9b8e8;
      animation: fadeSlide 0.8s 1s both;
    }
  </style>
</head>
<body>

  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <div class="hearts-bg" id="heartsContainer"></div>

  <div class="card">
    <span class="bear">🐻</span>
    <h1>I'm So Sorry!</h1>
    <p class="subtitle">From the bottom of my heart 💕</p>
    <div class="divider"></div>

    <p class="message">
      I know I messed up, and I'm truly, deeply sorry. 😔<br/>
      You mean <strong>so much</strong> to me, and the last thing I ever want is to hurt you.
    </p>

    <ul class="promises">
      <li><span class="icon">🌸</span> I promise to do better every single day.</li>
      <li><span class="icon">🌈</span> I'll make it up to you, I promise!</li>
    </ul>

    <button class="btn" id="acceptBtn">💌 Accept My Apology?</button>
    <p class="footer-note">P.S. — I brought virtual hugs & cookies 🍪🤗</p>
  </div>

  <script>
    // Floating hearts
    const container = document.getElementById('heartsContainer');
    const emojis = ['🩷','💕','💞','🌸','✨','💫','🌷','💝'];
    for (let i = 0; i < 22; i++) {
      const el = document.createElement('div');
      el.className = 'h';
      el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      el.style.left = Math.random() * 100 + 'vw';
      el.style.bottom = '-40px';
      el.style.animationDelay = (Math.random() * 6) + 's';
      el.style.animationDuration = (4 + Math.random() * 5) + 's';
      container.appendChild(el);
    }

    // Button confetti burst
    document.getElementById('acceptBtn').addEventListener('click', function(e) {
      const colors = ['#ff6b9d','#ffb3cc','#c9b8e8','#ffd6a5','#a8e6cf','#fdffb6'];
      for (let i = 0; i < 22; i++) {
        const dot = document.createElement('div');
        dot.className = 'dot';
        const angle = Math.random() * Math.PI * 2;
        const dist = 60 + Math.random() * 120;
        dot.style.setProperty('--tx', Math.cos(angle) * dist + 'px');
        dot.style.setProperty('--ty', Math.sin(angle) * dist + 'px');
        dot.style.background = colors[Math.floor(Math.random() * colors.length)];
        dot.style.left = e.clientX + 'px';
        dot.style.top  = e.clientY + 'px';
        document.body.appendChild(dot);
        setTimeout(() => dot.remove(), 900);
      }
      this.textContent = '🎉 Yay! Thank you!';
      this.style.background = 'linear-gradient(135deg, #a8e6cf, #7ec8e3)';
    });
  </script>
</body>
</html>
